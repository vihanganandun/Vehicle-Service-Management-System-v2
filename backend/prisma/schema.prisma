datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  STAFF
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ServiceStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  PAID
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(STAFF)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Customer {
  id           Int           @id @default(autoincrement())
  name         String
  phone        String
  email        String?
  address      String?
  vehicles     Vehicle[]
  appointments Appointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("customers")
}

model Vehicle {
  id                 Int           @id @default(autoincrement())
  registrationNumber String        @unique
  brand              String
  model              String
  vehicleType        String        @default("Car")
  year               Int?
  engineNumber       String?
  customerId         Int
  customer           Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  appointments       Appointment[]
  services           Service[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@map("vehicles")
}

model Appointment {
  id          Int               @id @default(autoincrement())
  customerId  Int
  customer    Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicleId   Int
  vehicle     Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  date        DateTime
  time        String
  serviceType String
  notes       String?           @db.Text
  status      AppointmentStatus @default(PENDING)
  services    Service[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("appointments")
}

model Service {
  id                Int           @id @default(autoincrement())
  appointmentId     Int?
  appointment       Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  vehicleId         Int
  vehicle           Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  serviceType       String
  customerComplaint String?       @db.Text
  workPerformed     String?       @db.Text
  partsUsed         String?       @db.Text
  labourCost        Float         @default(0)
  partsCost         Float         @default(0)
  totalCost         Float         @default(0)
  serviceDate       DateTime      @default(now())
  status            ServiceStatus @default(IN_PROGRESS)
  serviceItems      ServiceItem[]
  payment           Payment?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@map("services")
}

model ServiceItem {
  id         Int     @id @default(autoincrement())
  serviceId  Int
  service    Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  itemName   String
  itemType   String  @default("PART") // PART or LABOUR
  quantity   Int     @default(1)
  unitPrice  Float   @default(0)
  totalPrice Float   @default(0)

  @@map("service_items")
}

model Payment {
  id            Int           @id @default(autoincrement())
  serviceId     Int           @unique
  service       Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  amount        Float
  paymentDate   DateTime      @default(now())
  paymentMethod PaymentMethod @default(CASH)
  paymentStatus PaymentStatus @default(PAID)
  notes         String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("payments")
}
